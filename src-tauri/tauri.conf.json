{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inZOI Better Mod Manager",
  "version": "0.1.5",
  "identifier": "com.coolbirdzik.inzoi-better-mod-manager",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "inZOI Better Mod Manager",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#171719"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://media.forgecdn.net https://staticdelivery.nexusmods.com https://images.nexusmods.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://github.com https://api.github.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "inzoimm"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QTBCNjI4M0NEQjkwRjYKUldUMmtOczhLTGFnbE5YMHlPcyt6ZnpJS3NRcnE3NkhDcmhOdzZaNkh4Q1dKU2syd1VJMVRiMW8K",
      "endpoints": [
        "https://github.com/coolbirdzik/inzoi-better-mod-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  }
}
