{
  "identifier": "main",
  "description": "Local mod library and signed application updates",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{"url": "https://*"}, {"url": "http://*"}]
    },
    "deep-link:default",
    "updater:default",
    "process:allow-restart"
  ]
}
